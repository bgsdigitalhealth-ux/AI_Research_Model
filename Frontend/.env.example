# ==============================================================================
# AI Research Flow — Frontend Environment Configuration
# ==============================================================================

# Backend API Configuration
# Point this to your backend server endpoint
VITE_API_BASE_URL=http://localhost:8000/api

# Network Request Timeout (milliseconds)
VITE_API_TIMEOUT=15000

# Feature Flags
# AI Assistant entry point is enabled only when backend AI capability is available
VITE_ENABLE_AI_ASSISTANT=false

# Application Meta
VITE_APP_NAME="AI Research Flow"
VITE_APP_VERSION="1.0.0"

