# ==============================================================================
# AI Research Flow — Backend Environment Variables (Production & Render)
# Set these in Render Dashboard -> "Environment" tab
# ==============================================================================

PROJECT_NAME="AI Research Flow API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Supabase PostgreSQL Connection Strings
# Replace [YOUR-PASSWORD] with your actual Supabase DB password
DATABASE_URL="postgresql+asyncpg://postgres.vtxenwxeatsaaaeifrbd:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
SYNC_DATABASE_URL="postgresql://postgres.vtxenwxeatsaaaeifrbd:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Security (Cryptographically generated secret key)
SECRET_KEY="replace_with_a_secure_random_production_secret_key_at_least_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# CORS Origins Whitelist (Comma-separated or JSON list)
# Note: Any *.vercel.app domain is already automatically permitted by default regex
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Authentication Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Multi-Factor Authentication (MFA)
MFA_ISSUER_NAME="AI Research Flow"

# Object Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads/protocols"
STORAGE_MAX_FILE_SIZE_MB=50

# AI Provider Configuration (OpenAI gpt-4o)
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o"
AI_DATA_TRANSMISSION_POLICY_APPROVED=true
AI_STRIP_PARTICIPANT_IDENTIFIERS=true
