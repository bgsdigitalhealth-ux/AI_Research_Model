# ==============================================================================
# AI Research Flow — Backend Environment Variables Blueprint
# ==============================================================================

PROJECT_NAME="AI Research Flow API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL / Supabase)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For local PostgreSQL:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_research_flow"
# For Supabase Direct:
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# For Supabase Connection Pooler (Transaction pooler, port 6543):
# DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# For local SQLite zero-setup development:
# DATABASE_URL="sqlite+aiosqlite:///local_dev.db"

# Synchronous URL for Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_research_flow"

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Security (Cryptographically generated 64+ char secret key)
SECRET_KEY="REPLACE_WITH_A_REAL_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# CORS Whitelist (JSON array string)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# Authentication Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Multi-Factor Authentication (MFA)
MFA_ISSUER_NAME="AI Research Flow"

# Object Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads/protocols"
STORAGE_MAX_FILE_SIZE_MB=50

# AI Extraction Provider Configuration
# Set AI_PROVIDER to "gemini", "openai", or "unconfigured" (manual mode)
AI_PROVIDER="unconfigured"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
AI_DATA_TRANSMISSION_POLICY_APPROVED=true
AI_STRIP_PARTICIPANT_IDENTIFIERS=true

# SMTP Mailer (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@airesearchflow.org"
